<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xunqi.gulimall</groupId>
        <artifactId>gulimall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gulimall-common-cloud</artifactId>
    <description>公共微服务治理：Nacos 注册/配置、Sentinel、Zipkin</description>

    <dependencies>
        <dependency>
            <groupId>com.xunqi.gulimall</groupId>
            <artifactId>gulimall-common-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Nacos 仅作服务注册与发现（网关 lb:// 路由与 OpenFeign 调用依赖） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Sentinel 流控（默认全局关闭，见各服务 application.yml 的 sentinel.enabled=false） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
    </dependencies>
</project>
